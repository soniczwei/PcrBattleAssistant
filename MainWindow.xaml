<Window x:Class="PcrBattleAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:PcrBattleAssistant.ViewModels"
        xmlns:models="clr-namespace:PcrBattleAssistant.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="880"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#181B22">

    <Window.Resources>
        <Style x:Key="PrimaryScanBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="BorderBrush" Value="#58A6FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388BFD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UploadResultBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryScanBtnStyle}">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="BorderBrush" Value="#2EA043" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EA043" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryDarkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#262C36" />
            <Setter Property="BorderBrush" Value="#3D4450" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#373E4B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NewVersionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#D29922" />
            <Setter Property="BorderBrush" Value="#F0B72F" />
            <Setter Property="Foreground" Value="#12151C" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3B341" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 调试模式：原图切片与匹配度复用模板 -->
        <DataTemplate x:Key="DebugTeamDetailTemplate" DataType="{x:Type models:RecognizedTeamGroup}">
            <Border Background="#181C24"
                    BorderBrush="#262C36"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Foreground="#E6EDF3"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RecognizedSlot}">
                                <Border Background="#12151B"
                                        BorderBrush="#2D3440"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="3"
                                        Margin="2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="3" ClipToBounds="True" Margin="0,0,3,0"
                                                    ToolTip="{Binding DataContext.Loc.CropSliceTooltip, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Image Source="{Binding CroppedSlice}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="28" Height="28" CornerRadius="3" ClipToBounds="True"
                                                    ToolTip="{Binding DataContext.Loc.MatchedTemplateTooltip, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Image Source="{Binding MatchedIcon}" Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConfidenceText}"
                                                   Foreground="#58A6FF"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 精简顶部栏：扫描 + 战绩上传 + 调试模式 + 仿官方左右结构（左进攻 VS 右防守） -->
            <RowDefinition Height="Auto" />
            <!-- 主工作区：调试面板(按需显示) + WebView2 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部控制与左右阵容对照栏 ==================== -->
        <Border Grid.Row="0"
                Background="#1E222B"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="True">

                <!-- 左侧：扫描按钮 + 调试模式勾选 + 更新角色 + 语言 + 状态提示 -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding NewVersionButtonText}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NewVersionBtnStyle}"
                                    Command="{Binding OpenLatestReleaseCommand}"
                                    Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" />

                            <Button Content="{Binding Loc.ScanButtonText}"
                                    HorizontalAlignment="Stretch"
                                    Padding="24,10"
                                    FontSize="15.5"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource PrimaryScanBtnStyle}"
                                    Command="{Binding CaptureGameWindowCommand}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <CheckBox Content="{Binding Loc.DebugModeText}"
                                      IsChecked="{Binding IsDebugMode, Mode=TwoWay}"
                                      Foreground="#E6EDF3"
                                      FontSize="12.5"
                                      VerticalAlignment="Center"
                                      Cursor="Hand" />

                            <CheckBox Content="{Binding Loc.PrioritizeTrustedText}"
                                      Margin="10,0,0,0"
                                      IsChecked="{Binding PrioritizeTrusted, Mode=TwoWay}"
                                      Foreground="#E6EDF3"
                                      FontSize="12.5"
                                      VerticalAlignment="Center"
                                      Cursor="Hand" />

                            <Button Content="{Binding Loc.UpdateCharsText}"
                                    Margin="10,0,0,0"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource SecondaryDarkBtnStyle}"
                                    Command="{Binding SyncOnlineIconsCommand}" />

                            <ComboBox Margin="8,0,0,0"
                                      Width="88"
                                      Height="24"
                                      FontSize="11.5"
                                      VerticalContentAlignment="Center"
                                      IsEnabled="{Binding IsNotBusy}"
                                      ItemsSource="{Binding Loc.AvailableLanguages}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Language"
                                      SelectedValue="{Binding Loc.CurrentLanguage, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#FFA657"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：仿官方对战履历左右结构（左：进攻方 1~3队  VS  右：防守方 1~3队  + 每队独立上传按钮） -->
                <Grid VerticalAlignment="Center" IsEnabled="{Binding IsNotBusy}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：进攻方（战绩上传） -->
                    <Border Grid.Column="0"
                            Background="#151922"
                            BorderBrush="#263042"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.AttackLabel}"
                                       Foreground="#58A6FF"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Margin="2,0,0,4" />
                            <ItemsControl ItemsSource="{Binding AttackTeamGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RecognizedTeamGroup}">
                                        <Button Margin="0,1.5"
                                                Padding="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectAndUploadAttackTeamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="AtkCardBorder"
                                                            Padding="6,3"
                                                            Background="#181C24"
                                                            BorderBrush="#2E3543"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Title}"
                                                                       Foreground="#E6EDF3"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11.5"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="48"
                                                                       Margin="0,0,6,0" />
                                                            <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" Columns="5" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type models:RecognizedSlot}">
                                                                        <Border Width="32"
                                                                                Height="32"
                                                                                Margin="2,0"
                                                                                CornerRadius="4"
                                                                                Background="#12151B"
                                                                                BorderBrush="#30363D"
                                                                                BorderThickness="1"
                                                                                ClipToBounds="True">
                                                                            <Image Source="{Binding EffectiveAvatar}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="AtkCardBorder" Property="BorderBrush" Value="#2EA043" />
                                                            <Setter TargetName="AtkCardBorder" Property="Background" Value="#182A22" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AtkCardBorder" Property="BorderBrush" Value="#3FB950" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="AtkCardBorder" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 中间：VS 与左右互换按钮 -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <TextBlock Text="VS"
                                   Foreground="#FFA657"
                                   FontWeight="ExtraBold"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />

                        <Button Margin="0,6,0,0"
                                Padding="6,4"
                                Style="{StaticResource SecondaryDarkBtnStyle}"
                                ToolTip="{Binding Loc.SwapSidesTooltip}"
                                Command="{Binding SwapAttackAndDefenseCommand}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="1024" Height="1024">
                                    <Path Data="M234.666667 430.933333H128l85.333333-81.066666L345.6 213.333333l51.2 51.2-81.066667 81.066667H896V426.666667H234.666667v4.266666zM793.6 554.666667H896l-85.333333 81.066666-132.266667 132.266667-51.2-51.2 81.066667-81.066667H128V554.666667h665.6z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- 右列：防守方（扫描查作业） -->
                    <Border Grid.Column="2"
                            Background="#151922"
                            BorderBrush="#263042"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.DefenseLabel}"
                                       Foreground="#F85149"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Margin="2,0,0,4" />
                            <ItemsControl ItemsSource="{Binding DefenseTeamGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RecognizedTeamGroup}">
                                        <Button Margin="0,1.5"
                                                Padding="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectAndQueryDefenseTeamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DefCardBorder"
                                                            Padding="6,3"
                                                            Background="#181C24"
                                                            BorderBrush="#2E3543"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Title}"
                                                                       Foreground="#E6EDF3"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11.5"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="48"
                                                                       Margin="0,0,6,0" />
                                                            <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" Columns="5" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type models:RecognizedSlot}">
                                                                        <Border Width="32"
                                                                                Height="32"
                                                                                Margin="2,0"
                                                                                CornerRadius="4"
                                                                                Background="#12151B"
                                                                                BorderBrush="#30363D"
                                                                                BorderThickness="1"
                                                                                ClipToBounds="True">
                                                                            <Image Source="{Binding EffectiveAvatar}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="DefCardBorder" Property="BorderBrush" Value="#58A6FF" />
                                                            <Setter TargetName="DefCardBorder" Property="Background" Value="#1C2433" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DefCardBorder" Property="BorderBrush" Value="#58A6FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="DefCardBorder" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 最右侧：每队独立「上传」按钮（切换上传 Tab 并同时选上该行进攻与防守阵容） -->
                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,5">
                        <Button Content="{Binding Loc.RowUploadBtnText}"
                                Height="38"
                                Margin="0,1.5"
                                Style="{StaticResource SecondaryDarkBtnStyle}"
                                Command="{Binding UploadRowTeamCommand}"
                                CommandParameter="1" />
                        <Button Content="{Binding Loc.RowUploadBtnText}"
                                Height="38"
                                Margin="0,1.5"
                                Style="{StaticResource SecondaryDarkBtnStyle}"
                                Command="{Binding UploadRowTeamCommand}"
                                CommandParameter="2" />
                        <Button Content="{Binding Loc.RowUploadBtnText}"
                                Height="38"
                                Margin="0,1.5"
                                Style="{StaticResource SecondaryDarkBtnStyle}"
                                Command="{Binding UploadRowTeamCommand}"
                                CommandParameter="3" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ==================== 主工作区：调试面板(含区间截图+小头像+匹配度) + WebView2 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 调试模式面板：显示正在分析的区间截图 + 原图小头像切片与匹配度详情 -->
            <Border Grid.Column="0"
                    Width="460"
                    Background="#12151C"
                    BorderBrush="#30363D"
                    BorderThickness="0,0,1,0"
                    Padding="10"
                    Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc.AnalyzeZoneTitle}"
                                   Foreground="#58A6FF"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,6" />

                        <Border Background="#0D0F14"
                                BorderBrush="#262C36"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4"
                                MinHeight="220">
                            <Grid>
                                <TextBlock Text="{Binding Loc.WaitingScreenshotText}"
                                           Foreground="#484F58"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding DebugAnnotatedImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Loc.AttackSliceTitle}"
                                   Foreground="#3FB950"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding AttackTeamGroups}"
                                      ItemTemplate="{StaticResource DebugTeamDetailTemplate}" />

                        <TextBlock Text="{Binding Loc.DefenseSliceTitle}"
                                   Foreground="#F85149"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,10,0,6" />
                        <ItemsControl ItemsSource="{Binding DefenseTeamGroups}"
                                      ItemTemplate="{StaticResource DebugTeamDetailTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 双 WebView2 Tab 区：作业查询 (/battle) 与 战绩上传 (/battle/upload) 完全分离，共享登录态 -->
            <TabControl Grid.Column="1"
                        SelectedIndex="{Binding SelectedWebTabIndex, Mode=TwoWay}"
                        IsEnabled="{Binding IsNotBusy}"
                        Background="#181B22"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#8B949E" />
                        <Setter Property="Background" Value="#161920" />
                        <Setter Property="BorderBrush" Value="#30363D" />
                        <Setter Property="Padding" Value="16,6" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0,0,1,0"
                                            Padding="{TemplateBinding Padding}"
                                            Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E222B" />
                                            <Setter Property="Foreground" Value="#58A6FF" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#E6EDF3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="{Binding Loc.QueryTabTitle}">
                    <wv2:WebView2 x:Name="BattleQueryWebView"
                                  DefaultBackgroundColor="White" />
                </TabItem>

                <TabItem Header="{Binding Loc.UploadTabTitle}">
                    <wv2:WebView2 x:Name="BattleUploadWebView"
                                  DefaultBackgroundColor="White" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 初始化遮罩层（阻止初始化完成前误操作） -->
        <Border Grid.RowSpan="2"
                Panel.ZIndex="99"
                Background="#990D1017"
                Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}" />

        <!-- 初始化提示浮层（使用 Popup 穿透 WebView2 HWND 空域限制居中显示） -->
        <Popup IsOpen="{Binding IsInitializing, Mode=OneWay}"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True">
            <Border Background="#1E222B"
                    BorderBrush="#388BFD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28,22"
                    MinWidth="340">
                <StackPanel>
                    <TextBlock Text="{Binding Loc.InitOverlayTitle}"
                               Foreground="#E6EDF3"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,14,0,12"
                                 Foreground="#388BFD"
                                 Background="#12151C"
                                 BorderThickness="0" />
                    <TextBlock Text="{Binding InitializationMessage}"
                               Foreground="#8B949E"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
